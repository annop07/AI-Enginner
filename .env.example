# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (Azure, local, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Vector store (Qdrant) ---
# Local embedded file mode (default, no server needed):
QDRANT_LOCATION=./data/qdrant
# Or use a running server (see docker-compose.yml):
# QDRANT_LOCATION=http://localhost:6333
QDRANT_COLLECTION=knowledge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Agent ---
MAX_TOOL_ITERATIONS=5
